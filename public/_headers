/*
  X-Robots-Tag: noindex
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

# Without this the browser's 24-hour service worker update rule can delay a deploy reaching installed apps
# (/index.html itself redirects to /, so only / needs the rule)
/sw.js
  Cache-Control: no-cache
/
  Cache-Control: no-cache
